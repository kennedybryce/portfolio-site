---
const base = import.meta.env.BASE_URL;
---

<footer class="fixed bottom-0 left-0 right-0 z-30 border-t border-gray-dark/70 py-3 text-xs text-text-muted bg-surface-dark">
  <div class="max-w-5xl mx-auto px-4 flex justify-between items-center">
    <div class="flex flex-col gap-1">
      <span class="flex items-center gap-3">
        <span class="text-text-muted">Built with</span>

        <img
          src={`${base}icons/astro-svgrepo-com.svg`}
          alt="Astro"
          class="footer-icon w-5 h-5"
        />
        <img
          src={`${base}icons/react-svgrepo-com.svg`}
          alt="React"
          class="footer-icon w-5 h-5"
        />
        <img
          src={`${base}icons/rive_square.svg`}
          alt="Rive"
          class="footer-icon w-5 h-5"
        />
        <img
          src={`${base}icons/tailwind-svgrepo-com.svg`}
          alt="Tailwind CSS"
          class="footer-icon w-5 h-5"
        />
      </span>

      <span>© {new Date().getFullYear()} Bryce Kennedy</span>
    </div>

    <button
      id="theme-toggle"
      class="theme-toggle"
      aria-label="Toggle light/dark theme"
      title="Toggle theme"
    >
      <!-- Sun icon (shown in dark mode) -->
      <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>

      <!-- Moon icon (shown in light mode) -->
      <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>
  </div>
</footer>

<style>
  /* Footer icon styling - theme aware */
  .footer-icon {
    filter: brightness(0) invert(1); /* White for dark mode */
  }

  :global([data-theme="light"]) .footer-icon {
    filter: brightness(0); /* Black for light mode */
  }

  .theme-toggle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--theme-border);
    background-color: var(--theme-surface-card);
    color: var(--theme-text-primary);

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;
    transition: all 0.3s ease;
  }

  .theme-toggle:hover {
    border-color: var(--theme-accent);
    transform: scale(1.1);
  }

  .theme-toggle:active {
    transform: scale(0.95);
  }

  /* Icon visibility based on theme */
  .icon-sun {
    display: block;
  }

  .icon-moon {
    display: none;
  }

  :global([data-theme="light"]) .icon-sun {
    display: none;
  }

  :global([data-theme="light"]) .icon-moon {
    display: block;
  }
</style>

<script>
  // Theme toggle functionality
  function initThemeToggle() {
    const toggle = document.getElementById('theme-toggle');
    const html = document.documentElement;

    // Get saved theme or default to dark
    const savedTheme = localStorage.getItem('theme') || 'dark';
    html.setAttribute('data-theme', savedTheme);

    toggle?.addEventListener('click', () => {
      const currentTheme = html.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

      html.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
    });
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThemeToggle);
  } else {
    initThemeToggle();
  }
</script>
