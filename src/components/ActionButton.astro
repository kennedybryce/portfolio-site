---
interface Props {
  icon: string;
  text: string;
  subtitle?: string;
  href: string;
  variant?: "primary" | "secondary";
  download?: boolean;
  external?: boolean;
}

const {
  icon,
  text,
  subtitle,
  href,
  variant = "secondary",
  download = false,
  external = false
} = Astro.props;

const base = import.meta.env.BASE_URL;

const variantClasses = {
  primary: "border-brand-orange bg-brand-orange text-white hover:opacity-90",
  secondary: "btn-secondary btn-secondary-border text-text-light hover:text-brand-orange hover:border-brand-orange",
};
---

<div class="flex flex-col items-center gap-2 w-full md:w-auto">
  <a
    href={href}
    class={`inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 border transition w-full md:w-auto ${variantClasses[variant]}`}
    {...download ? { download: true } : {}}
    {...external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
  >
    <img
      src={`${base}icons/${icon}`}
      alt=""
      class={`w-5 h-5 brightness-0 invert ${variant === "primary" ? "icon-white" : "icon-accent-hover"}`}
    />
    {text}
  </a>
  {subtitle && <p class="text-xs text-slate-400">{subtitle}</p>}
</div>
