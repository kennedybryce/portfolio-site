---
import BaseLayout from "../layouts/BaseLayout.astro";
import RiveIconButton from "../components/RiveIconButton";
import RiveActionButton from "../components/RiveActionButton";
import TechIconShowcase from "../components/TechIconShowcase";
import RiveTechIconGroup from "../components/RiveTechIconGroup";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Home – Bryce Kennedy">
  <div slot="hero" class="snap-section">
    <section class="min-h-screen flex items-center justify-center" id="test">
      <div class="max-w-3xl mx-auto px-4 text-center space-y-8">
        <div class="space-y-4">
          <div class="text-xs uppercase tracking-[0.25em] text-sky-300/80">
            <span
              >UX Engineering · Front-End Development · Design Systems ·
              Enterprise Platforms</span
            >
          </div>

          <h1
            class="text-2xl md:text-3xl lg:text-4xl font-semibold leading-tight text-slate-300"
          >
            I design and build reliable, high-visibility interfaces for complex
            enterprise systems.
          </h1>

          <h3
            class="text-1xl md:text-5xl lg:text-2xl font-semibold leading-tight"
          >
            The online portfolio of Bryce Kennedy
          </h3>

          <p class="text-slate-400 max-w-xl mx-auto text-base md:text-lg pt-0">
            I’m a UX-minded engineer with deep experience building
            enterprise-scale interfaces using Angular, React, and modern
            intranet platforms. My work spans internal tools, digital signage
            systems, and shared UI architectures, with a focus on integrations
            that keep complex enterprise experiences fast, consistent, and
            maintainable.
          </p>
        </div>

        <div
          class="flex flex-col md:flex-row md:flex-wrap gap-6 text-sm justify-center pt-8 w-full"
        >
          <RiveActionButton
            client:load
            artboard="resume"
            text="Download Resume"
            subtitle="PDF Format"
            href={`${base}documents/Bryce_Kennedy_Resume_2026.pdf`}
            variant="primary"
            download
          />
          <RiveActionButton
            client:load
            artboard="linkedin"
            text="Connect on LinkedIn"
            subtitle="linkedin.com/in/2kennedyb"
            href="https://www.linkedin.com/in/2kennedyb"
            external
          />
          <RiveActionButton
            client:load
            artboard="email"
            text="Get in touch"
            subtitle="kennedybryce2@gmail.com"
            href="mailto:kennedybryce2@gmail.com"
          />
          
        </div>
      </div>
    </section>
  </div>

  <!-- Projects Section -->
  <section
    id="projects"
    class="snap-section max-w-5xl mx-auto px-4 py-16 md:py-20 space-y-8 fade-section min-h-screen flex flex-col justify-center"
  >
    <div class="space-y-4">
      <h2 class="text-2xl md:text-3xl font-semibold">Recent Projects</h2>
      <p>
        These projects showcase recent work designing and building
        high-visibility interfaces for complex enterprise systems. They reflect
        my approach to UX engineering, front-end architecture, and creating
        scalable solutions across intranet platforms, internal tools, and
        digital signage environments.
      </p>
    </div>

    <!-- Project Cards Grid -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-2 mt-8">
      <!-- Project Card 1 -->
      <a
        href={`${base}projects/digital-signage`}
        class="bg-surface-card border border-gray-dark/70 rounded-lg overflow-hidden hover:border-brand-orange/50 transition flex flex-col group"
