</BaseLayout>

<style>
  /* Scroll snap container */
  :global(body) {
    scroll-behavior: smooth;
  }

  /* Only enable scroll snap on larger screens */
  @media (min-width: 768px) {
    :global(body) {
      scroll-snap-type: y proximity;
    }

    .snap-section {
      scroll-snap-align: start;
    }
  }

  .fade-section {
    opacity: 0;
    transform: translateY(50px);
    transition:
      opacity 0.8s ease-out,
      transform 0.8s ease-out;
  }

  .fade-section.fade-in {
    opacity: 1;
    transform: translateY(0);
  }

  .fade-section.fade-out {
    opacity: 0;
    transform: translateY(-50px);
  }
</style>

<script>
  // Wait for DOM to be ready
  function initFadeAnimations() {
    // Intersection Observer for fade-in/fade-out animations
    const observerOptions = {
      root: null,
      rootMargin: "-50px 0px -50px 0px",
      threshold: [0, 0.05, 0.1, 0.15, 0.2],
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const target = entry.target as HTMLElement;

        // Calculate how much of the element is visible
        const visibilityRatio = entry.intersectionRatio;

        if (visibilityRatio > 0.05) {
          // Element is sufficiently visible - fade in
          target.classList.add("fade-in");
          target.classList.remove("fade-out");
        } else if (!entry.isIntersecting) {
          // Element is not visible - fade out
          target.classList.remove("fade-in");
          target.classList.add("fade-out");
        }
      });
    }, observerOptions);

    // Observe all fade sections
    const sections = document.querySelectorAll(".fade-section");
    sections.forEach((section) => {
      observer.observe(section);
    });

    // Trigger initial check
    setTimeout(() => {
      sections.forEach((section) => {
        const rect = section.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        const margin = 50;

        // Check if section is in the visible area
        if (rect.top < windowHeight - margin && rect.bottom > margin) {
          section.classList.add("fade-in");
          section.classList.remove("fade-out");
        }
      });
    }, 100);
  }

  // Initialize when DOM is ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFadeAnimations);
  } else {
    initFadeAnimations();
  }
</script>
