        <div class="aspect-video bg-gray-dark/30 overflow-hidden">
          <video
            autoplay
            loop
            muted
            playsinline
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          >
            <source
              src={`${base}videos/digital-signage-intro.mp4`}
              type="video/mp4"
            />
          </video>
        </div>
        <div class="p-6 flex-1 flex flex-col gap-3">
          <h3
            class="text-lg font-semibold group-hover:text-brand-orange transition-colors"
          >
            Digital Signage System
