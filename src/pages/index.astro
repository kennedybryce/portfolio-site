          <p class="text-sm text-slate-300">
            Enterprise real-time content delivery for large-format displays.
          </p>
          <div class="mt-auto">
            <RiveTechIconGroup
              client:load
              size="large"
              icons={[
                { artboard: "wordpress", label: "WordPress" },
                { artboard: "typescript", label: "TypeScript" },
                { artboard: "javascript", label: "JavaScript" },
                { artboard: "html", label: "HTML" },
                { artboard: "css", label: "CSS" },
